{
  "name": "com.nonsensicallab.nonsensicalkit.simulation",
  "displayName": "NonsensicalKit.Simulation",
  "author": {
    "name": "NonsensicalLab"
  },
  "version": "0.9.3",
  "unity": "2021.3",
  "license": "MIT",
  "description": "模拟实训与脚本动画能力包，覆盖交互训练、库存导航、参数化货架，以及 Timeline 脚本动画（路网、叉车、堆垛机、机械臂、开箱、缠膜等）。依赖 Core、DigitalTwin、Timeline；缠膜 Shader 需 URP。",
  "dependencies": {
    "com.nonsensicallab.nonsensicalkit.core": "1.0.7",
    "com.nonsensicallab.nonsensicalkit.digitaltwin": "1.1.2",
    "com.unity.timeline": "1.6.5"
  },
  "samples": [
    {
      "displayName": "Sample Training",
      "description": "示例训练",
      "path": "Samples~/Sample Training"
    },
    {
      "displayName": "ParametricModelingShelves",
      "description": "参数化货架",
      "path": "Samples~/ParametricModelingShelves"
    },
    {
      "displayName": "WarehouseSimulation",
      "description": "出入库仿真",
      "path": "Samples~/WarehouseSimulation"
    },
    {
      "displayName": "ScriptAnimation",
      "description": "Timeline 脚本动画综合演示（含 OpenBox、FilmWrapping 子场景）。导入后可用菜单 Tools/ScriptAnimation 打开。",
      "path": "Samples~/ScriptAnimation"
    }
  ]
}
